			"type": "Microsoft.Synapse/workspaces/managedVirtualNetworks/managedPrivateEndpoints",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"privateLinkResourceId": "/subscriptions/cf3cf956-64a6-4499-b7dc-136e9d68f7c9/resourceGroups/SynapseRG/providers/Microsoft.Storage/storageAccounts/synapseworkspaceblob",
				"groupId": "dfs",
				"fqdns": [
					"synapseworkspaceblob.dfs.core.windows.net"
				]
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/managedVirtualNetworks/default')]"
			]
		},
		{
			"name": "[concat(parameters('workspaceName'), '/default/synapse-ws-sql--shawntestmpeworkspace')]",
			"type": "Microsoft.Synapse/workspaces/managedVirtualNetworks/managedPrivateEndpoints",
			"apiVersion": "2019-06-01-preview",
