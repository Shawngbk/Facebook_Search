		{
			"name": "[concat(parameters('workspaceName'), '/default/synapse-ws-sqlOnDemand--shawntestmpeworkspace')]",
			"type": "Microsoft.Synapse/workspaces/managedVirtualNetworks/managedPrivateEndpoints",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"privateLinkResourceId": "/subscriptions/cf3cf956-64a6-4499-b7dc-136e9d68f7c9/resourceGroups/SynapseRG/providers/Microsoft.Synapse/workspaces/shawntestmpeworkspace",
				"groupId": "sqlOnDemand",
				"fqdns": [
					"shawntestmpeworkspace-ondemand.064fab6d-81ad-4cae-a2b4-4fc02c3e3c3a.sql.azuresynapse.net"
				]
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/managedVirtualNetworks/default')]"
			]
		},
		{
			"name": "[concat(parameters('workspaceName'), '/sparkConfiguration1')]",
			"type": "Microsoft.Synapse/workspaces/sparkConfigurations",
			"apiVersion": "2019-06-01-preview",
			"properties": {
